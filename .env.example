YADISK_TOKEN=your_yandex_disk_oauth_token

# Logging (optional)
# LOG_LEVEL=INFO|DEBUG|WARNING
# DEPS_LOG_LEVEL=WARNING|ERROR
#
# Telegram network tuning (optional; helps avoid "stuck" replies on flaky connections)
# TELEGRAM_SEND_TIMEOUT_SEC=12
# TELEGRAM_SEND_MAX_ATTEMPTS=3
# TELEGRAM_READ_TIMEOUT_SEC=10
# TELEGRAM_WRITE_TIMEOUT_SEC=10
# TELEGRAM_CONNECT_TIMEOUT_SEC=5
# TELEGRAM_POOL_TIMEOUT_SEC=1
# CONCURRENT_UPDATES=1

LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
WHISPER_API_KEY=your_whisper_api_key
